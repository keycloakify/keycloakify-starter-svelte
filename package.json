{
  "name": "keycloakify-starter-svelte",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build-keycloak-theme": "pnpm build && keycloakify build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "format": "prettier --write '**/*.{ts,html,json,md,svelte}'",
    "lint": "pnpm format && eslint . --fix",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@keycloakify/svelte": "^2.0.1",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/addon-svelte-csf": "5.1.6",
    "@storybook/svelte": "^10.6.7",
    "@storybook/svelte-vite": "^10.6.7",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tsconfig/svelte": "^5.0.9",
    "@types/eslint": "^9.6.1",
    "dompurify": "^3.4.17",
    "eslint": "10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-storybook": "^10.6.7",
    "eslint-plugin-svelte": "^3.24.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.14.0",
    "keycloakify": "^11.16.4",
    "npm-check-updates": "^23.1.1",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.1.1",
    "storybook": "^10.6.7",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "tsafe": "^1.8.12",
    "tslib": "^2.9.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8"
  },
  "packageManager": "pnpm@12.18.0"
}
